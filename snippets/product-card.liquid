<article class="product-card">
  <a href="{{ product.url }}" class="product-card-image">
    {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: product.featured_image.alt | escape }}{% else %}<div class="image-placeholder"></div>{% endif %}
    {% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}
  </a>
  <div class="product-card-meta"><div><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p>{{ product.vendor }}</p></div><span>{{ product.price | money }}</span></div>
</article>
