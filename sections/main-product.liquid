<section class="product-page page-width"><div class="product-media">{% for image in product.images %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', alt: image.alt | escape }}{% endfor %}</div><div class="product-info"><p class="eyebrow">{{ product.vendor }}</p><h1>{{ product.title }}</h1><p class="product-price">{{ product.price | money }}</p><div class="rte">{{ product.description }}</div>{% form 'product', product, class: 'product-form' %}{% unless product.has_only_default_variant %}<label for="VariantSelect">Choose an option</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<button class="button button-dark" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %} <span>→</span></button>{% endform %}<div class="product-details"><details open><summary>Details</summary><p>Thoughtfully made, easy to live with, and designed to age beautifully.</p></details><details><summary>Shipping & returns</summary><p>Complimentary shipping over $120. Returns accepted within 30 days.</p></details></div></div></section>
