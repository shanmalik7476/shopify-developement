<section class="cart-page page-width"><div class="cart-heading"><p class="eyebrow">Your edit</p><h1>Shopping bag</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-items">{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{{ item.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: item.image.alt | escape }}</a><div><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2><p>{{ item.variant.title }}</p><label for="Quantity-{{ item.key }}">Quantity</label><input id="Quantity-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><p>{{ item.final_line_price | money }}</p></div></div>{% endfor %}</div><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="button button-dark" type="submit" name="checkout">Checkout <span>→</span></button></div></form>{% else %}<div class="empty-state"><h2>Your bag is waiting.</h2><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Continue shopping <span>↗</span></a></div>{% endif %}</section>
