<section class="collection-page page-width"><div class="collection-heading"><p class="eyebrow">Collection / {{ collection.products_count }} pieces</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div><div class="collection-toolbar"><span>{{ collection.products_count }} products</span><select aria-label="Sort products" onchange="window.location=this.value"><option value="{{ collection.url }}?sort_by=manual">Featured</option>{% for option in collection.sort_options %}<option value="{{ collection.url }}?sort_by={{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></div><div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div></section>
